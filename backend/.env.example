# ---- Database ----
DATABASE_URL="postgresql://qbank_user:CHANGE_ME@localhost:5432/qbank?schema=public"

# ---- Redis (sessions, rate-limit counters, exam release locks) ----
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
JWT_ACCESS_SECRET="generate_with_openssl_rand_hex_64"
JWT_REFRESH_SECRET="generate_a_different_one_with_openssl_rand_hex_64"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---- App-layer encryption for secrets stored in DB (SMTP creds, MFA secrets) ----
FIELD_ENCRYPTION_KEY="32_byte_key_base64_generate_with_openssl_rand_base64_32"

# ---- Server ----
PORT=4000
NODE_ENV="production"
CORS_ORIGIN="https://your-frontend-domain.com"

# ---- Question paper release mechanism ----
# The release key that unlocks a scheduled paper is generated per-schedule
# and never stored in plaintext; PAPER_RELEASE_HMAC_SECRET signs the
# time-locked release tokens issued by the scheduler job.
PAPER_RELEASE_HMAC_SECRET="generate_with_openssl_rand_hex_64"

# ---- Rate limiting / brute force ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
