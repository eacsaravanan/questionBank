# Root-level env consumed by docker-compose.yml.
# Generate secrets with: openssl rand -hex 64   (for the JWT/HMAC secrets)
#                         openssl rand -base64 32  (for FIELD_ENCRYPTION_KEY)

POSTGRES_PASSWORD=change_me_to_a_long_random_value
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FIELD_ENCRYPTION_KEY=
PAPER_RELEASE_HMAC_SECRET=
CORS_ORIGIN=http://localhost:8080
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_DOCUMENT_AI_LOCATION=asia-south1
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your-processor-id
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
ANTHROPIC_API_KEY=
RECONCILIATION_MODEL=claude-sonnet-5
